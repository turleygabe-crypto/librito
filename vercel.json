{
  "version": 2,
  "name": "librito",
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.{html,css,js,png,webmanifest}",
      "use": "@vercel/static"
    },
    {
      "src": "assets/**",
      "use": "@vercel/static"
    },
    {
      "src": "robots.txt",
      "use": "@vercel/static"
    },
    {
      "src": "lib/{supabase-client,billing-status}.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    { "src": "/api/([^/.]+)", "dest": "/api/$1.js" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
